 min-width:160px; display:grid; gap:3px; padding-left:8px; }
+.dock-help span { font-size:12px; font-weight:700; }
+.dock-help small { color:var(--muted); font-size:9px; }
+.command-dock .turn-buttons button { height:54px; min-width:64px; }
+.sidebar { grid-row:3; min-height:0; overflow:auto; }
+.workspace { grid-row:3; min-height:0; }
+.nation-identity { align-items:center; }
+.nation-identity .character-portrait { width:48px; height:48px; flex:none; }
+.nation-identity span { color:var(--faint); font-size:9px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.character-portrait { width:72px; height:72px; flex:none; border-radius:18px; border:1px solid rgba(255,255,255,.08); }
+.sidebar-guide { width:100%; margin-top:18px; padding:12px; display:grid; gap:4px; text-align:left; border:1px solid rgba(56,189,248,.25); border-radius:10px; color:#a4e3ff; background:rgba(56,189,248,.08); cursor:pointer; }
+.sidebar-guide small { color:var(--muted); font-size:9px; }
+.game-status-row { display:grid; grid-template-columns:minmax(0,1fr) 260px; gap:14px; margin-bottom:14px; }
+.mission-card,.grade-card { border:1px solid color-mix(in srgb,var(--accent) 32%,var(--line)); border-radius:14px; background:linear-gradient(135deg,rgba(17,44,67,.94),rgba(8,22,38,.96)); }
+.mission-card { min-height:118px; display:grid; grid-template-columns:64px 1fr auto; align-items:center; gap:16px; padding:17px; }
+.mission-step { width:58px; height:58px; border-radius:18px; display:flex; align-items:baseline; justify-content:center; gap:2px; background:var(--accent-soft); border:1px solid rgba(56,189,248,.35); }
+.mission-step strong { color:var(--accent); font-size:26px; }
+.mission-step span { color:var(--muted); font-size:10px; }
+.mission-card>div:nth-child(2) { display:grid; gap:4px; }
+.mission-card>div:nth-child(2)>span { color:var(--accent); font-size:9px; letter-spacing:.14em; font-weight:700; }
+.mission-card h3 { margin:0; font-size:17px; }
+.mission-card p { margin:0; color:var(--muted); font-size:11px; line-height:1.55; }
+.grade-card { padding:15px 18px; display:grid; grid-template-columns:1fr auto; grid-template-rows:auto 1fr; align-items:center; }
+.grade-card>span { color:var(--muted); font-size:10px; }
+.grade-card>strong { grid-row:1/-1; grid-column:2; color:var(--accent); font-size:60px; line-height:1; text-shadow:0 0 24px color-mix(in srgb,var(--accent) 35%,transparent); }
+.grade-card>div { display:grid; gap:4px; }
+.grade-card b { font-size:14px; }
+.grade-card small { color:var(--muted); font-size:9px; }
+.advisor-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-bottom:14px; }
+.advisor-card { min-height:152px; display:flex; gap:13px; padding:14px; border:1px solid var(--line-soft); border-radius:13px; background:rgba(10,23,39,.86); }
+.advisor-card--danger { border-color:rgba(251,113,133,.36); }
+.advisor-card--watch { border-color:rgba(251,191,36,.30); }
+.advisor-card>div { min-width:0; display:grid; align-content:start; gap:5px; }
+.advisor-card span { color:var(--accent); font-size:9px; }
+.advisor-card h3 { margin:0; font-size:13px; line-height:1.45; }
+.advisor-card p { margin:0; color:var(--muted); font-size:10px; line-height:1.55; }
+.drawer-backdrop,.modal-backdrop { position:fixed; inset:0; z-index:90; background:rgba(1,6,13,.68); backdrop-filter:blur(3px); }
+.command-drawer { position:fixed; z-index:100; top:0; right:0; bottom:0; width:min(480px,92vw); padding:22px; background:#081522; border-left:1px solid var(--line); box-shadow:-30px 0 80px rgba(0,0,0,.42); overflow:auto; }
+.guide-modal { position:fixed; z-index:100; width:min(860px,88vw); max-height:82vh; overflow:auto; left:50%; top:50%; transform:translate(-50%,-50%); padding:24px; border:1px solid var(--line); border-radius:18px; background:#091725; box-shadow:var(--shadow); }
+.drawer-header { display:flex; align-items:flex-start; justify-content:space-between; gap:18px; padding-bottom:16px; border-bottom:1px solid var(--line); }
+.drawer-header span { color:var(--accent); font-size:9px; letter-spacing:.16em; }
+.drawer-header h2 { margin:5px 0 0; font-size:20px; }
+.drawer-header>button,.queue-list button { border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--muted); padding:8px 10px; cursor:pointer; }
+.queue-policy { margin-top:15px; padding:13px; display:grid; gap:5px; border:1px solid rgba(56,189,248,.25); border-radius:10px; background:var(--accent-soft); }
+.queue-policy span { color:var(--muted); font-size:10px; }
+.queue-list { list-style:none; padding:0; margin:15px 0; display:grid; gap:9px; }
+.queue-list li { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px; border:1px solid var(--line-soft); border-radius:10px; background:rgba(14,29,47,.75); }
+.queue-list li>div { display:grid; gap:4px; }
+.queue-list strong { font-size:12px; }
+.queue-list small { color:var(--muted); font-size:9px; }
+.drawer-actions { display:flex; justify-content:flex-end; gap:9px; padding-top:15px; border-top:1px solid var(--line); }
+.guide-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:18px; }
+.guide-grid article { padding:16px; border:1px solid var(--line-soft); border-radius:12px; background:rgba(15,31,50,.75); }
+.guide-grid h3 { margin:0 0 10px; font-size:14px; }
+.guide-grid p,.guide-grid li { color:var(--muted); font-size:11px; line-height:1.75; }
+.guide-grid ol { margin:0; padding-left:18px; }
+@media (max-width:1350px) {
+  .console-shell { grid-template-columns:190px 1fr; }
+  .game-status-row { grid-template-columns:1fr 220px; }
+  .advisor-grid { grid-template-columns:1fr; }
+  .advisor-card { min-height:auto; }
+  .dock-help { display:none; }
+}
diff --git a/src/domain/command-planning.ts b/src/domain/command-planning.ts
new file mode 100644
index 0000000..97c7eb8
--- /dev/null
+++ b/src/domain/command-planning.ts
@@ -0,0 +1,100 @@
+import { getLawDefinition } from '../politics/catalog.js';
+import type { PlayerCommand, WorldState } from './types.js';
+
+export interface CommandCost {
+  politicalCapital: number;
+  treasury: number;
+}
+
+export type QueueInspection =
+  | { ok: true; cost: CommandCost; total: CommandCost; message: string }
+  | { ok: false; cost: CommandCost; total: CommandCost; message: string };
+
+const intelligenceCosts = { reconnaissance: 2.5, influence: 4.5, sabotage: 7 } as const;
+
+export function commandKey(command: PlayerCommand): string {
+  switch (command.type) {
+    case 'set-tax-rate': return `${command.type}:${command.tax}`;
+    case 'set-budget-share': return `${command.type}:${command.category}`;
+    case 'set-policy-rate':
+    case 'set-research-focus':
+    case 'set-military-budget':
+    case 'set-intelligence-budget':
+    case 'mobilize': return command.type;
+    case 'propose-trade-agreement':
+    case 'end-trade-agreement': return `${command.type}:${command.targetNationId}`;
+    case 'propose-law':
+    case 'repeal-law': return `${command.type}:${command.lawId}`;
+    case 'call-snap-election': return command.type;
+    case 'start-infrastructure-project': return `${command.type}:${command.regionId}:${command.projectType}`;
+    case 'respond-to-crisis': return `${command.type}:${command.crisisId}`;
+    case 'declare-war': return `${command.type}:${command.targetNationId}`;
+    case 'offer-peace': return `${command.type}:${command.warId}`;
+    case 'launch-intelligence-operation': return `${command.type}:${command.targetNationId}:${command.operationType}`;
+  }
+}
+
+export function estimateCommandCost(world: WorldState, command: PlayerCommand): CommandCost {
+  let politicalCapital = 0;
+  let treasury = 0;
+  if (command.type === 'propose-law') politicalCapital = getLawDefinition(command.lawId)?.politicalCost ?? 0;
+  if (command.type === 'repeal-law') politicalCapital = Math.ceil((getLawDefinition(command.lawId)?.politicalCost ?? 0) * 0.6);
+  if (command.type === 'call-snap-election') politicalCapital = 35;
+  if (command.type === 'declare-war') politicalCapital = 24;
+  if (command.type === 'launch-intelligence-operation') treasury = intelligenceCosts[command.operationType] ?? 0;
+  return { politicalCapital, treasury };
+}
+
+export function inspectQueuedCommand(world: WorldState, queued: PlayerCommand[], next: PlayerCommand): QueueInspection {
+  const cost = estimateCommandCost(world, next);
+  const total = queued.reduce((sum, command) => {
+    const item = estimateCommandCost(world, command);
+    return { politicalCapital: sum.politicalCapital + item.politicalCapital, treasury: sum.treasury + item.treasury };
+  }, { politicalCapital: cost.politicalCapital, treasury: cost.treasury });
+  if (queued.some((command) => commandKey(command) === commandKey(next))) {
+    return { ok: false, cost, total, message: '同じ内容はすでに未確定命令へ入っています。先に取り消すか、そのままターンを進めてください。' };
+  }
+  const nation = world.nations[world.playerNationId];
+  const politicalShortage = total.politicalCapital - world.politics[world.playerNationId].politicalCapital;
+  if (politicalShortage > 0) {
+    return { ok: false, cost, total, message: `政治資本があと${politicalShortage.toFixed(0)}不足しています。未確定の法案を取り消すか、支持率を保って1か月進めると政治資本が回復します。` };
+  }
+  const treasuryShortage = total.treasury - nation.treasury;
+  if (treasuryShortage > 0) {
+    return { ok: false, cost, total, message: `国庫があと${treasuryShortage.toFixed(1)}不足しています。高額な命令を取り消すか、税収が入るまで1か月進めてください。` };
+  }
+  return { ok: true, cost, total, message: costSummary(cost) };
+}
+
+export function costSummary(cost: CommandCost): string {
+  const parts: string[] = [];
+  if (cost.politicalCapital > 0) parts.push(`政治資本 ${cost.politicalCapital.toFixed(0)}`);
+  if (cost.treasury > 0) parts.push(`国庫 ${cost.treasury.toFixed(1)}`);
+  return parts.length > 0 ? parts.join(' / ') : '即時費用なし';
+}
+
+export function commandLabel(command: PlayerCommand): string {
+  switch (command.type) {
+    case 'propose-law': return `法案提出：${getLawDefinition(command.lawId)?.name ?? command.lawId}`;
+    case 'repeal-law': return `法律廃止：${getLawDefinition(command.lawId)?.name ?? command.lawId}`;
+    case 'call-snap-election': return '解散総選挙';
+    case 'set-tax-rate': return `${command.tax}税率を${command.value.toFixed(1)}%へ変更`;
+    case 'set-policy-rate': return `政策金利を${command.value.toFixed(1)}%へ変更`;
+    case 'set-budget-share': return `${command.category}予算を${command.value.toFixed(1)}%へ変更`;
+    case 'set-research-focus': return `研究重点：${command.field}`;
+    case 'propose-trade-agreement': return '貿易協定を提案';
+    case 'end-trade-agreement': return '貿易協定を終了';
+    case 'start-infrastructure-project': return `公共事業：${command.projectType}`;
+    case 'respond-to-crisis': return `危機対応：${command.response}`;
+    case 'set-military-budget': return `国防予算を${command.value.toFixed(1)}%へ変更`;
+    case 'mobilize': return `動員：${command.level}`;
+    case 'declare-war': return '宣戦布告';
+    case 'offer-peace': return '講和を提案';
+    case 'set-intelligence-budget': return `情報予算を${command.value.toFixed(1)}%へ変更`;
+    case 'launch-intelligence-operation': return `情報作戦：${command.operationType}`;
+  }
+}
