lection') politicalCapital = 35;
+  if (command.type === 'declare-war') politicalCapital = 45;
+  if (command.type === 'launch-intelligence-operation') treasury = intelligenceCosts[command.operationType];
+  if (command.type === 'respond-to-crisis') {
+    const crisis = world.activeCrises[command.crisisId];
+    const share = command.response === 'emergency' ? 0.012 : command.response === 'measured' ? 0.006 : 0.0025;
+    if (crisis) treasury = world.nations[world.playerNationId].gdp * share * crisis.severity;
+  }
+  return { politicalCapital, treasury };
+}
+
+export function queuedCommandCost(world: WorldState, commands: PlayerCommand[]): CommandCost {
+  return commands.reduce((total, command) => {
+    const cost = estimateCommandCost(world, command);
+    return { politicalCapital: total.politicalCapital + cost.politicalCapital, treasury: total.treasury + cost.treasury };
+  }, { politicalCapital: 0, treasury: 0 });
+}
+
+export function inspectCommandQueue(world: WorldState, existing: PlayerCommand[], candidate: PlayerCommand): QueueInspection {
+  const cost = estimateCommandCost(world, candidate);
+  if (existing.some((item) => commandKey(item) === commandKey(candidate))) {
+    return { ok: false, cost, total: queuedCommandCost(world, existing), message: '同じ命令がすでに追加されています。命令一覧から取り消して変更してください。' };
+  }
+  const total = queuedCommandCost(world, [...existing, candidate]);
+  const nation = world.nations[world.playerNationId];
+  const parliament = world.parliaments[world.playerNationId];
+  if (total.politicalCapital > parliament.politicalCapital) {
+    const shortage = Math.ceil(total.politicalCapital - parliament.politicalCapital);
+    return { ok: false, cost, total, message: `政治資本が${shortage}不足しています。支持率と国家安定を保ってターンを進めると回復します。` };
+  }
+  if (total.treasury > nation.treasury) {
+    const shortage = Math.ceil(total.treasury - nation.treasury);
+    return { ok: false, cost, total, message: `国庫が${shortage}B不足しています。高額命令を取り消すか、税収を確保してから実行してください。` };
+  }
+  return { ok: true, cost, total, message: '命令を追加できます。' };
+}
+
+export function commandLabel(world: WorldState, command: PlayerCommand): string {
+  const nationName = (id: string): string => world.nations[id as keyof typeof world.nations]?.shortName ?? id;
+  switch (command.type) {
+    case 'set-tax-rate': return `${command.tax === 'income' ? '所得税' : command.tax === 'corporate' ? '法人税' : '消費税'}を${(command.value * 100).toFixed(1)}%へ変更`;
+    case 'set-policy-rate': return `政策金利を${(command.value * 100).toFixed(1)}%へ変更`;
+    case 'set-budget-share': return `${command.category === 'education' ? '教育' : command.category === 'healthcare' ? '医療' : '産業'}予算を${(command.value * 100).toFixed(1)}%へ変更`;
+    case 'propose-trade-agreement': return `${nationName(command.targetNationId)}へ貿易協定を提案`;
+    case 'end-trade-agreement': return `${nationName(command.targetNationId)}との貿易協定を終了`;
+    case 'propose-law': return `${getLawDefinition(command.lawId)?.name ?? command.lawId}を提出`;
+    case 'repeal-law': return `${getLawDefinition(command.lawId)?.name ?? command.lawId}を廃止`;
+    case 'call-snap-election': return '解散総選挙を実施';
+    case 'set-research-focus': return `研究重点を${command.focus}へ変更`;
+    case 'start-infrastructure-project': return `${world.regions[command.regionId]?.name ?? command.regionId}で${command.projectType}事業を開始`;
+    case 'respond-to-crisis': return `国家危機へ${command.response === 'emergency' ? '緊急' : command.response === 'measured' ? '重点' : '地方'}対応`;
+    case 'set-military-budget': return `国防予算を${(command.value * 100).toFixed(1)}%へ変更`;
+    case 'mobilize': return command.level === 'none' ? '動員を解除' : command.level === 'partial' ? '部分動員' : '全面動員';
+    case 'declare-war': return `${nationName(command.targetNationId)}へ宣戦`;
+    case 'offer-peace': return '講和を提案';
+    case 'set-intelligence-budget': return `情報予算を${(command.value * 100).toFixed(1)}%へ変更`;
+    case 'launch-intelligence-operation': return `${nationName(command.targetNationId)}へ${command.operationType === 'reconnaissance' ? '戦略偵察' : command.operationType === 'influence' ? '世論工作' : '産業破壊'}を実行`;
+  }
+}
