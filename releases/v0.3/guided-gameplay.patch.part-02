+  { title: '1か月進めて変化を見よう', description: '最初は命令を追加せず、経済と国民の自然な変化を確認します。', actionLabel: '上部の1か月を押す', actionTab: 'dashboard' },
+  { title: '税と予算の関係を知ろう', description: '税率を上げると国庫は増えますが、家計や企業の負担も増えます。', actionLabel: '政策・予算を開く', actionTab: 'policies' },
+  { title: '国民生活を確認しよう', description: '低所得層・中間層・高所得層で政策の影響が異なります。', actionLabel: '国民・社会を開く', actionTab: 'society' },
+  { title: '議会と政治資本を確認しよう', description: '法案や選挙には政治資本が必要です。使い切らず余裕を残します。', actionLabel: '政治・議会を開く', actionTab: 'politics' },
+  { title: '法案を1つ検討しよう', description: '効果・必要政治資本・議会支持を見てから法案を追加します。', actionLabel: '法案一覧を見る', actionTab: 'politics' },
+  { title: '産業の状態を確認しよう', description: '企業利益と雇用は税率・需要・物価の影響を受けます。', actionLabel: '産業・企業を開く', actionTab: 'companies' },
+  { title: '研究分野を選ぼう', description: '研究はすぐ効きませんが、長期的な国家成長を支えます。', actionLabel: '研究・公共事業を開く', actionTab: 'development' },
+  { title: '外交関係を確認しよう', description: '信頼・脅威・依存を見て、協定を提案する相手を選びます。', actionLabel: '外交を開く', actionTab: 'diplomacy' },
+  { title: '危機対応を確認しよう', description: '危機が起きると複数月進行が停止します。対応費用と効果を比較します。', actionLabel: '危機管理を開く', actionTab: 'crises' },
+  { title: '複数月進行を試そう', description: '平時は3か月、危険があるときは1か月進行がおすすめです。', actionLabel: '上部の進行ボタンを使う', actionTab: 'dashboard' },
+  { title: '自由統治を始めよう', description: 'アドバイザーの提案を参考に、国家目標を自分で決めます。', actionLabel: '国家概況へ戻る', actionTab: 'dashboard' },
