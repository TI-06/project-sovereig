+  step: number;
+  total: number;
+  title: string;
+  description: string;
+  actionLabel: string;
+  actionTab: TabId;
+}
+
+export interface AdvisorMessage {
+  role: '財務官' | '国民生活担当' | '外交安全保障官';
+  name: string;
+  mood: 'good' | 'watch' | 'danger';
+  summary: string;
+  advice: string;
+  actionTab: TabId;
+}
+
+export interface NationGrade {
+  grade: 'S' | 'A' | 'B' | 'C' | 'D' | 'F';
+  score: number;
+  label: string;
+}
+
