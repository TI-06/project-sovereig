' },
+];
+
+export function getMission(world: WorldState): Mission {
+  const index = Math.min(missions.length - 1, Math.max(0, world.turn));
+  return { ...missions[index]!, step: index + 1, total: missions.length };
+}
+
+export function getNationGrade(world: WorldState): NationGrade {
+  const nation = world.nations[world.playerNationId];
+  const debtRatio = nation.debt / Math.max(1, nation.gdp);
+  const score = Math.max(0, Math.min(100,
+    nation.approval * 0.22 + nation.stability * 0.18 + (100 - nation.unemployment * 500) * 0.14
+    + (100 - Math.min(100, Math.abs(nation.inflation - 0.02) * 600)) * 0.12
+    + Math.max(0, 100 - debtRatio * 45) * 0.12 + nation.consumerConfidence * 0.1
+    + nation.businessConfidence * 0.12));
+  const grade = score >= 88 ? 'S' : score >= 78 ? 'A' : score >= 66 ? 'B' : score >= 54 ? 'C' : score >= 40 ? 'D' : 'F';
+  const label = grade === 'S' ? '繁栄国家' : grade === 'A' ? '安定成長' : grade === 'B' ? '堅調' : grade === 'C' ? '要注意' : grade === 'D' ? '危機前夜' : '国家危機';
+  return { grade, score: Math.round(score), label };
+}
+
+export function getAdvisorBriefing(world: WorldState): AdvisorMessage[] {
+  const nation = world.nations[world.playerNationId];
+  const debtRatio = nation.debt / Math.max(1, nation.gdp);
+  const finance: AdvisorMessage = nation.treasury < 12
+    ? { role: '財務官', name: 'ミラ・ヴォス', mood: 'danger', summary: '国庫の余裕がほとんどありません。', advice: '高額命令を控え、税収と月次収支を改善してください。', actionTab: 'policies' }
+    : debtRatio > 1.2
+      ? { role: '財務官', name: 'ミラ・ヴォス', mood: 'watch', summary: '政府債務が大きくなっています。', advice: '増税だけでなく、歳出と成長率の両方を見直してください。', actionTab: 'economy' }
+      : { role: '財務官', name: 'ミラ・ヴォス', mood: 'good', summary: '財政には当面の余力があります。', advice: '国庫を残しつつ、教育や産業へ段階的に投資できます。', actionTab: 'policies' };
+
+  const society: AdvisorMessage = nation.unemployment > 0.09
+    ? { role: '国民生活担当', name: 'ユナ・レイ', mood: 'danger', summary: '仕事を失う国民が増えています。', advice: '産業支援や景気刺激を検討し、急な増税は避けてください。', actionTab: 'society' }
+    : nation.approval < 45
+      ? { role: '国民生活担当', name: 'ユナ・レイ', mood: 'watch', summary: '政権への不満が広がっています。', advice: '階層別の幸福度を確認し、負担が偏っている層へ対応してください。', actionTab: 'society' }
+      : { role: '国民生活担当', name: 'ユナ・レイ', mood: 'good', summary: '国民生活は比較的安定しています。', advice: '支持率があるうちに中長期政策を進める好機です。', actionTab: 'politics' };
+
+  const dangerousRelation = Object.values(world.relations).find((relation) => relation.fromNationId === world.playerNationId && relation.threat > 65);
+  const crisis = Object.values(world.activeCrises).find((item) => item.nationId === world.playerNationId);
+  const security: AdvisorMessage = crisis
+    ? { role: '外交安全保障官', name: 'カイ・ローデン', mood: 'danger', summary: '国内で国家危機が進行しています。', advice: '複数月進行を避け、危機管理画面で対応方法を選んでください。', actionTab: 'crises' }
+    : dangerousRelation
+      ? { role: '外交安全保障官', name: 'カイ・ローデン', mood: 'watch', summary: '周辺国の脅威が高まっています。', advice: '外交関係を改善するか、防衛準備を段階的に進めてください。', actionTab: 'diplomacy' }
+      : { role: '外交安全保障官', name: 'カイ・ローデン', mood: 'good', summary: '重大な安全保障上の脅威はありません。', advice: '貿易と信頼関係を広げ、将来の危機に備えてください。', actionTab: 'diplomacy' };
+  return [finance, society, security];
+}
