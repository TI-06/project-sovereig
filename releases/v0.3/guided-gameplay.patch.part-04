+    return `<li><div><strong>${escapeHtml(commandLabel(world!, command))}</strong><small>${escapeHtml(detail)}</small></div><button type="button" data-remove-command="${index}">取り消す</button></li>`;
+  }).join('');
+  return `<div class="drawer-backdrop" data-action="toggle-queue"></div><aside class="command-drawer" aria-label="未確定命令">
+    <div class="drawer-header"><div><span>COMMAND QUEUE</span><h2>次のターンに実行する命令</h2></div><button type="button" data-action="toggle-queue">閉じる</button></div>
+    ${policy.length ? `<div class="queue-policy"><strong>政策・予算変更 ${policy.length}件</strong><span>政策画面で変更内容を確認できます。</span></div>` : ''}
+    ${items ? `<ul class="queue-list">${items}</ul>` : '<div class="empty-state"><strong>追加済みの命令はありません</strong><span>何もせずターンを進めることもできます。</span></div>'}
+    <div class="drawer-actions"><button type="button" class="button button--danger" data-action="clear-queue" ${queuedCommands.length || policy.length ? '' : 'disabled'}>すべて取り消す</button><button type="button" class="button button--secondary" data-action="toggle-queue">戻る</button></div>
+  </aside>`;
