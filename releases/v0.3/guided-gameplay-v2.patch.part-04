diff --git a/src/ui/portraits.ts b/src/ui/portraits.ts
new file mode 100644
index 0000000..3dd7cd4
--- /dev/null
+++ b/src/ui/portraits.ts
@@ -0,0 +1,23 @@
+export type PortraitId = 'leader' | 'finance' | 'society' | 'security';
+
+const faces: Record<PortraitId, { hair: string; coat: string; accent: string; label: string }> = {
+  leader: { hair: '#202a44', coat: '#24385f', accent: '#d4af6a', label: '国家元首' },
+  finance: { hair: '#4d3044', coat: '#344a63', accent: '#78c4b4', label: '財務官' },
+  society: { hair: '#6b3d31', coat: '#64405d', accent: '#e4a9b0', label: '国民生活担当' },
+  security: { hair: '#30343b', coat: '#3f4b3e', accent: '#b8c58c', label: '外交安全保障官' },
+};
+
+export function portrait(id: PortraitId): string {
+  const item = faces[id];
+  return `<svg class="character-portrait" viewBox="0 0 96 96" role="img" aria-label="${item.label}">
+    <defs><linearGradient id="bg-${id}" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${item.coat}"/><stop offset="1" stop-color="#111827"/></linearGradient></defs>
+    <rect width="96" height="96" rx="24" fill="url(#bg-${id})"/>
+    <circle cx="48" cy="39" r="22" fill="#e7bd9a"/>
+    <path d="M25 40c0-22 10-31 24-31 15 0 25 11 23 31-7-8-14-12-24-12-9 0-16 4-23 12Z" fill="${item.hair}"/>
+    <circle cx="40" cy="41" r="2" fill="#263238"/><circle cx="57" cy="41" r="2" fill="#263238"/>
+    <path d="M42 52c4 3 8 3 12 0" fill="none" stroke="#9b604f" stroke-width="2" stroke-linecap="round"/>
+    <path d="M17 96c2-24 14-35 31-35s30 11 32 35" fill="${item.coat}"/>
+    <path d="m39 63 9 12 9-12" fill="${item.accent}"/>
+    <circle cx="75" cy="21" r="8" fill="${item.accent}" opacity=".9"/><path d="M72 21h6M75 18v6" stroke="#101827" stroke-width="1.6"/>
+  </svg>`;
+}
