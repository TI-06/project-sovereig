+export type TabId = 'dashboard' | 'policies' | 'politics' | 'economy' | 'companies' | 'society' | 'development' | 'diplomacy' | 'defense' | 'intelligence' | 'crises' | 'report';
diff --git a/tests/command-planning.test.ts b/tests/command-planning.test.ts
new file mode 100644
index 0000000..90e550c
--- /dev/null
+++ b/tests/command-planning.test.ts
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createInitialWorld } from '../dist/src/content/create-world.js';
+import { inspectCommandQueue, commandKey, commandLabel } from '../dist/src/domain/command-planning.js';
+
+const world = createInitialWorld({ playerNationId: 'nation:arcadia', seed: 'planning-test' });
+
+test('rejects commands whose cumulative political cost exceeds current capital', () => {
+  const first = { type: 'propose-law', lawId: 'universal-healthcare' } as const;
+  const second = { type: 'propose-law', lawId: 'industrial-strategy' } as const;
+  const third = { type: 'call-snap-election' } as const;
+  const result = inspectCommandQueue(world, [first, second], third);
+  assert.equal(result.ok, false);
+  assert.match(result.message, /政治資本が13不足/);
+});
+
+test('rejects an identical queued command before advancing', () => {
+  const command = { type: 'propose-law', lawId: 'industrial-strategy' } as const;
+  const result = inspectCommandQueue(world, [command], command);
+  assert.equal(result.ok, false);
+  assert.match(result.message, /同じ命令/);
+});
+
+test('reports treasury costs for intelligence operations', () => {
+  const command = { type: 'launch-intelligence-operation', targetNationId: 'nation:valen', operationType: 'sabotage' } as const;
+  const result = inspectCommandQueue(world, [], command);
+  assert.equal(result.ok, true);
+  assert.equal(result.cost.treasury, 7);
+  assert.match(commandLabel(world, command), /産業破壊/);
+});
+
+test('command keys distinguish targets but collapse replaceable settings', () => {
+  assert.equal(commandKey({ type: 'set-policy-rate', value: 0.02 }), 'set-policy-rate');
+  assert.notEqual(
+    commandKey({ type: 'propose-trade-agreement', targetNationId: 'nation:valen' }),
+    commandKey({ type: 'propose-trade-agreement', targetNationId: 'nation:selene' }),
+  );
+});
diff --git a/tests/guidance.test.ts b/tests/guidance.test.ts
new file mode 100644
index 0000000..1e097a7
--- /dev/null
+++ b/tests/guidance.test.ts
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createInitialWorld } from '../dist/src/content/create-world.js';
+import { getAdvisorBriefing, getMission, getNationGrade } from '../dist/src/ui/guidance.js';
+
+test('new players receive an actionable first mission', () => {
+  const world = createInitialWorld({ playerNationId: 'nation:arcadia', seed: 'guide-test' });
+  const mission = getMission(world);
+  assert.equal(mission.step, 1);
+  assert.match(mission.title, /国家の状態/);
+  assert.ok(mission.actionTab);
+});
+
+test('advisor briefing explains a concrete next action', () => {
+  const world = createInitialWorld({ playerNationId: 'nation:arcadia', seed: 'guide-test' });
+  world.nations[world.playerNationId].treasury = 3;
+  const briefing = getAdvisorBriefing(world);
+  assert.equal(briefing[0]?.role, '財務官');
+  assert.match(briefing[0]?.advice ?? '', /高額命令|税収|国庫/);
+});
+
+test('nation grade is a familiar letter rank', () => {
+  const world = createInitialWorld({ playerNationId: 'nation:arcadia', seed: 'guide-test' });
+  assert.match(getNationGrade(world).grade, /^[SABCDF]$/);
+});
